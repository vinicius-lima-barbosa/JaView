{
  "openapi": "3.0.0",
  "info": {
    "title": "JaView API",
    "version": "1.0.0",
    "description": "JaView's API Documentation"
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/auth/register": {
      "post": {
        "summary": "Register new user",
        "tags": ["Auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "email", "password"],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  }
                }
              },
              "example": {
                "name": "johndoe",
                "email": "johndoe@email.com",
                "password": "strongpassword123"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User created with success",
            "content": {
              "application/json": {
                "example": {
                  "message": "User created with success",
                  "user": {
                    "id": "12345",
                    "name": "johndoe",
                    "email": "johndoe@email.com"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation Error"
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "User login",
        "tags": ["Auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  }
                }
              },
              "example": {
                "email": "johndoe@email.com",
                "password": "strongpassword123"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Logged with success",
            "content": {
              "application/json": {
                "example": {
                  "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/movies/{movieId}/reviews": {
      "post": {
        "summary": "Add review in a movie",
        "tags": ["Movies"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "movieId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["review", "rating"],
                "properties": {
                  "review": {
                    "type": "string"
                  },
                  "rating": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 5
                  }
                }
              },
              "example": {
                "review": "One of the best movies i've ever see.",
                "rating": 4.5
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Review added with success",
            "content": {
              "application/json": {
                "example": {
                  "message": "Review added with success",
                  "review": {
                    "review": "One of the best movies i've ever see.",
                    "rating": 4.5,
                    "user_id": "abc123",
                    "created_at": "2025-04-09T14:32:00Z"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid data"
          }
        }
      },
      "get": {
        "summary": "List movie reviews",
        "tags": ["Movies"],
        "parameters": [
          {
            "name": "movieId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List movie reviews returned with success"
          }
        }
      }
    },
    "/movies/{movieId}/reviews/{reviewId}": {
      "delete": {
        "summary": "Remove movie review",
        "tags": ["Movies"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "movieId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "reviewId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Review removed with success"
          },
          "404": {
            "description": "Review not found"
          }
        }
      }
    },
    "/user/reviews": {
      "get": {
        "summary": "List reviews of a logged user",
        "tags": ["User"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Reviews list returned with success"
          }
        }
      }
    },
    "/user/profile": {
      "get": {
        "summary": "Get logged user profile",
        "tags": ["User"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Logged user profile returned with success",
            "content": {
              "application/json": {
                "example": {
                  "name": "johndoe",
                  "bio": "Developer in love with cinema",
                  "email": "johndoe@email.com",
                  "role": "user"
                }
              }
            }
          }
        }
      }
    },
    "/user/search-user": {
      "get": {
        "summary": "Search user by username",
        "tags": ["User"],
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User found with success"
          },
          "404": {
            "description": "User not found"
          }
        }
      }
    },
    "/user/update-profile": {
      "put": {
        "summary": "Update user bio",
        "tags": ["User"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "bio": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Profile updated with success"
          },
          "400": {
            "description": "Error in profile update"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Auth",
      "description": "Auth Endpoints"
    },
    {
      "name": "Movies",
      "description": "Movie Endpoints"
    },
    {
      "name": "User",
      "description": "User Endpoints"
    }
  ]
}
